# Copy to .env for local development only. Do not commit .env.
#
# Required for contact and careers forms to send email via Hostinger SMTP.
# Use SMTP (outgoing), NOT IMAP — imap.hostinger.com is only for reading mail in an inbox app.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@zorqiva.org
SMTP_PASS=your-email-password

# Hostinger reference (same mailbox password for all):
#   Send (forms) → smtp.hostinger.com  port 465 or 587
#   Read (inbox) → imap.hostinger.com   port 993  (not used by this site)

# If port 465 fails, try TLS on 587 instead:
# SMTP_PORT=587

# Optional overrides (defaults to contact@zorqiva.org)
# MAIL_FROM=contact@zorqiva.org
# MAIL_TO=contact@zorqiva.org

# Deployment (Vercel):
# 1. Push to Git; Vercel runs `bun run build` automatically.
# 2. Do NOT commit .output or .vercel — they are gitignored build artifacts.
# 3. Project → Settings → Environment Variables: add SMTP_HOST, SMTP_PORT,
#    SMTP_USER, SMTP_PASS (and optional MAIL_FROM / MAIL_TO) for Production.
# 4. Redeploy after adding or changing variables.
