<mjml>
  <mj-head>
    <mj-title>{{ pageTitle }}</mj-title>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="15px" color="#374151" line-height="1.6" />
      <mj-button
        background-color="#3a9d7a"
        color="#ffffff"
        font-size="14px"
        font-weight="700"
        border-radius="6px"
        inner-padding="12px 22px"
      />
      <mj-divider border-color="#e5e7eb" border-width="1px" />
    </mj-attributes>
    <mj-style inline="inline">
      .category-pill {
        display: inline-block;
        padding: 5px 11px;
        background-color: rgba(58, 157, 122, 0.12);
        border: 1px solid rgba(58, 157, 122, 0.28);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #3a9d7a;
      }
      .accent-line {
        height: 3px;
        width: 40px;
        background-color: #3a9d7a;
        border-radius: 999px;
      }
      .message-box {
        border-left: 3px solid #3a9d7a !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eef1f0" width="600px">
    <mj-section background-color="#1a3d32" padding="28px 32px 26px">
      <mj-column>
        <mj-image
          href="{{siteUrl}}"
          src="{{logoUrl}}"
          alt="{{brandName}}"
          width="200px"
          align="left"
          padding="0"
        />
        <mj-text padding="18px 0 0">
          <div class="accent-line"></div>
        </mj-text>
        {{ categorySection }}
        <mj-text
          font-size="22px"
          font-weight="700"
          color="#ffffff"
          line-height="1.3"
          padding="14px 0 0"
        >
          {{ title }}
        </mj-text>
        {{ subtitleSection }}
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        {{ body }}
        <mj-button href="mailto:{{replyEmail}}" align="left" padding="28px 0 0">
          Reply to {{ replyLabel }}
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 32px 28px">
      <mj-column>
        <mj-divider padding="0 0 20px" />
        <mj-text padding="0 0 4px" font-size="13px" font-weight="600" color="#111827">
          {{ legalEntity }}
        </mj-text>
        <mj-text padding="0 0 8px" font-size="12px" line-height="1.5" color="#6b7280">
          {{ tagline }}
        </mj-text>
        <mj-text padding="0" font-size="12px" line-height="1.5" color="#6b7280">
          <a href="mailto:{{brandEmail}}" style="color: #3a9d7a; text-decoration: none">{{
            brandEmail
          }}</a>
          &nbsp;·&nbsp;
          <a href="{{siteUrl}}" style="color: #3a9d7a; text-decoration: none">{{ domain }}</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
